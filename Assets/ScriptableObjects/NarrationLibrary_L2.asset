    pauseAfter: 1.1
    readSeconds: 16.174074
    segments:
    - text: Every word does this at once,
      weight: 1.79
      cues:
      - real
    - text: in twelve layers,
      weight: 1.25
      cues: []
    - text: with heads that each look for different things.
      weight: 2.55
      cues: []
