  - line: 203
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: 38e9da9c956eae94faa8a7702ae915e5, type: 3}
    pauseAfter: 0.44000003
    readSeconds: 8.598148
    segments:
    - text: A computer can't read letters.
      weight: 1.897
      cues:
      - sentence
    - text: So the machine's first job is to chop your words into pieces.
      weight: 3.79
      cues: []
    - text: The pieces are called tokens.
      weight: 1.54
