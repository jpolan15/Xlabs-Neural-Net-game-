  entries:
  - line: 200
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: 768630c3b1ff2724894dffdbabafaa71, type: 3}
    pauseAfter: 0.88000005
    readSeconds: 11.929629
    segments:
    - text: Welcome back!
      weight: 1.32
      cues:
      - chat
    - text: Last time,
      weight: 1.04
      cues: []
    - text: you taught Pixel to read handwritten numbers.
      weight: 2.891
      cues: []
    - text: 'Look:'
      weight: 0.73
      cues:
      - pixel
    - text: Pixel can see now!
      weight: 1.57
      cues: []
    - text: But its chat is still locked.
      weight: 1.79
      cues: []
    - text: Today,
      weight: 0.78
      cues: []
    - text: we unlock it.
      weight: 0.94
      cues: []
  - line: 201
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: 0bcd3c4b9542ea94b9de8b31b91ba41f, type: 3}
    pauseAfter: 0.88000005
    readSeconds: 12.881481
    segments:
    - text: You type a question into a chatbot,
      weight: 2.15
      cues:
      - type
    - text: and an answer comes back,
      weight: 1.6
      cues: []
    - text: one word at a time.
      weight: 1.73
      cues: []
    - text: Today,
      weight: 0.78
      cues:
      - inside
    - text: we ride a bike right inside the machine,
      weight: 2.35
      cues: []
    - text: and watch how it works.
      weight: 1.22
      cues: []
  - line: 242
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: e9342f80350910b4f954b3bfeb98a6db, type: 3}
    pauseAfter: 0.88000005
    readSeconds: 7.0962963
    segments:
    - text: If you're on a real bike,
      weight: 1.5
      cues:
      - bike
    - text: pedal along!
      weight: 1.24
      cues: []
    - text: If you're in a chair,
      weight: 1.12
      cues: []
    - text: just enjoy the ride.
      weight: 1.34
      cues: []
  - line: 202
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: 26feab8e55b13b94ba3af8e36e449cc7, type: 3}
    pauseAfter: 0.88000005
    readSeconds: 10.348148
    segments:
    - text: 'Five stops on the way:'
      weight: 1.65
      cues:
      - stops
    - text: tokens,
      weight: 1.03
      cues: []
    - text: meaning,
      weight: 0.91
      cues: []
    - text: attention,
      weight: 1.05
      cues: []
    - text: prediction,
      weight: 1.01
      cues: []
    - text: and writing.
      weight: 1.23
      cues: []
    - text: Everything you'll see comes from a real language model,
      weight: 3.02
      cues:
      - real
    - text: called GPT-2.
      weight: 1.37
      cues: []
  - line: 203
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: 38e9da9c956eae94faa8a7702ae915e5, type: 3}
    pauseAfter: 1.1
    readSeconds: 13.651852
    segments:
    - text: 'First stop:'
      weight: 1.05
      cues:
      - sentence
    - text: the chopper.
      weight: 1.25
      cues: []
    - text: The machine can't learn every word there is,
      weight: 2.54
      cues: []
    - text: and single letters mean too little.
      weight: 2.23
      cues: []
    - text: So it chops your words into pieces in between.
      weight: 2.65
      cues:
      - chop
    - text: The pieces are called tokens.
      weight: 1.54
      cues: []
  - line: 204
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: a48978b896c7f6347972a7486e05590d, type: 3}
    pauseAfter: 1.1
    readSeconds: 8.677777
    segments:
    - text: GPT-2 knows about fifty thousand tokens,
      weight: 3.585
      cues:
      - ids
    - text: and every token has a number,
      weight: 1.79
      cues: []
    - text: like a name tag.
      weight: 1.48
      cues: []
    - text: These are its real numbers.
      weight: 1.49
      cues: []
  - line: 248
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: 0652721e67c333542a111e5f28452da4, type: 3}
    pauseAfter: 1.1
    readSeconds: 33.65926
    segments:
    - text: So where does it chop?
      weight: 1.54
      cues:
      - glue
    - text: Before GPT-2 learned anything,
      weight: 2.14
      cues: []
    - text: a program read a mountain of text,
      weight: 2.18
      cues: []
    - text: 'and wrote a glue list:'
      weight: 1.49
      cues: []
    - text: first glue the two pieces seen side by side most often,
      weight: 3.41
      cues: []
    - text: then the next pair,
      weight: 1.24
      cues: []
    - text: fifty thousand times.
      weight: 1.82
      cues: []
    - text: Take the word the.
      weight: 1.28
      cues:
      - the
    - text: H and E are glue number three.
      weight: 2.15
      cues: []
    - text: Then T joins them.
      weight: 1.54
      cues: []
    - text: One token.
      weight: 1.36
      cues: []
    - text: Chatbot was rare back then.
      weight: 1.85
      cues:
      - chatbot
    - text: It gets glued into chat and bot,
      weight: 2.09
      cues: []
    - text: but no rule glues those two.
      weight: 1.89
      cues: []
    - text: So it stays two tokens.
      weight: 1.46
      cues: []
  - line: 249
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: b0e35ca50c33c104b867f73ff1709270, type: 3}
    pauseAfter: 1.1
    readSeconds: 13.992593
    segments:
    - text: When you type,
      weight: 1
      cues:
      - same
    - text: the chopper follows the same glue list,
      weight: 2.27
      cues: []
    - text: in the same order.
      weight: 1.42
      cues: []
    - text: So a word is always chopped the same way.
      weight: 2.41
      cues: []
    - text: Common words end up whole.
      weight: 1.63
      cues: []
    - text: Rare words end up in pieces.
      weight: 1.65
      cues: []
  - line: 205
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: c96152716b1b9e140a298ebd10a6b94a, type: 3}
    pauseAfter: 1.1
    readSeconds: 7.1666665
    segments:
    - text: A word the glue list has rarely seen gets chopped a lot.
      weight: 3.56
      cues:
      - rare
    - text: This long one becomes eleven tokens!
      weight: 2.251
      cues:
      - boss
  - line: 206
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: 02361e258b5188c43b1233beba0f373e, type: 3}
    pauseAfter: 0.66
    readSeconds: 8.237037
    segments:
    - text: 'Your turn:'
      weight: 0.94
      cues:
      - slice
    - text: be the chopper.
      weight: 1.27
      cues: []
    - text: Swipe your laser through the glowing seams,
      weight: 2.37
      cues: []
    - text: or shoot them.
      weight: 1.26
      cues: []
    - text: Leave whole words alone.
      weight: 1.39
      cues: []
  - line: 207
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: e599da16b6dc9d14ca01d25a5950ea96, type: 3}
    pauseAfter: 0.22000001
    readSeconds: 3.5333333
    segments:
    - text: That one is a single token.
      weight: 1.88
      cues: []
    - text: Leave it whole.
      weight: 0.82
      cues: []
  - line: 208
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: ea8f2254dfa061140bd63745a623add2, type: 3}
    pauseAfter: 0.22000001
    readSeconds: 3.162963
    segments:
    - text: The big one!
      weight: 0.96
      cues: []
    - text: Swipe all the way through.
      weight: 1.35
      cues: []
  - line: 209
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: bf39e07b5fecab745a5af5ded7a4bfdd, type: 3}
    pauseAfter: 0.66
    readSeconds: 5.514815
    segments:
    - text: Chopped!
      weight: 0.92
      cues: []
    - text: From now on,
      weight: 1.04
      cues: []
    - text: the machine never sees letters,
      weight: 1.88
      cues: []
    - text: only these numbered pieces.
      weight: 1.53
      cues: []
  - line: 210
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: 0fd269a4d9434e445a300b88cfb76f38, type: 3}
    pauseAfter: 1.1
    readSeconds: 7.0666666
    segments:
    - text: But a token's number is just a name tag.
      weight: 2.85
      cues:
      - name
    - text: The number for cat tells you nothing about cats.
      weight: 2.58
      cues: []
  - line: 243
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: d13db3207508f2d45ae1471eca0fc68c, type: 3}
    pauseAfter: 1.1
    readSeconds: 16.855555
    segments:
    - text: So the machine looks each token up in a giant table,
      weight: 3.1
      cues:
      - table
    - text: and gets seven hundred and sixty-eight numbers that describe it.
      weight: 3.69
      cues: []
    - text: Nobody typed those numbers in.
      weight: 2
      cues:
      - learned
    - text: The machine learned them in training,
      weight: 1.79
      cues: []
    - text: the same way Pixel learned its weights in Level 1.
      weight: 2.84
      cues: []
  - line: 247
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: 8458ee1309d08df4fbd217a77b17e3ef, type: 3}
    pauseAfter: 1.1
    readSeconds: 9.218518
    segments:
    - text: It also adds where each token sits in the sentence,
      weight: 3.09
      cues:
      - place
    - text: so dog bites man
      weight: 1.49
      cues: []
    - text: and man bites dog
      weight: 1.44
      cues: []
    - text: don't mean the same thing.
      weight: 1.18
      cues: []
  - line: 212
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: 8ae478bdd0a16db488d14f427c147c57, type: 3}
    pauseAfter: 1.1
    readSeconds: 10.159259
    segments:
    - text: Seven hundred and sixty-eight numbers is too many to picture.
      weight: 3.75
      cues:
      - squash
    - text: So we squashed them down to three.
      weight: 2.16
      cues: []
    - text: Now every word is a point in space.
      weight: 1.944
      cues:
      - space
  - line: 211
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: 8bf090ebf0fcddb4a944c42204cd77a1, type: 3}
    pauseAfter: 1.1
    readSeconds: 6.5259256
    segments:
    - text: 'And look:'
      weight: 0.86
      cues:
      - close
    - text: words with similar meanings ended up close together.
      weight: 3.31
      cues: []
    - text: Nobody told it to do that.
      weight: 1.5
      cues: []
  - line: 213
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: a89be1514b160dc4abf451e3d6ad8f22, type: 3}
    pauseAfter: 1.1
    readSeconds: 23.87037
    segments:
    - text: Now watch the machine do math with meaning.
      weight: 2.63
      cues:
      - math
    - text: Here are eight of king's seven hundred and sixty-eight numbers.
      weight: 3.829
      cues: []
    - text: Take away man's numbers,
      weight: 1.88
      cues:
      - minus
    - text: and add woman's numbers,
      weight: 1.71
      cues:
      - plus
    - text: one column at a time.
      weight: 1.81
      cues: []
    - text: 'Then it checks every token it knows:'
      weight: 2.22
      cues:
      - search
    - text: whose numbers are closest to the answer?
      weight: 2.49
      cues: []
    - text: Queen!
      weight: 0.98
      cues:
      - queen
    - text: Nobody taught it that.
      weight: 1.42
      cues: []
    - text: It learned it from reading.
      weight: 1.22
      cues: []
  - line: 214
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: e30bae4d9bdcd3a418a4a5feb9add82b, type: 3}
    pauseAfter: 0.66
    readSeconds: 8.407407
    segments:
    - text: 'Your turn:'
      weight: 0.94
      cues:
      - sort
    - text: sort the loose words into their neighbourhoods.
      weight: 2.45
      cues: []
    - text: Point at a word,
      weight: 1.17
      cues: []
    - text: hold the trigger,
      weight: 1.13
      cues: []
    - text: and carry it home.
      weight: 0.99
      cues: []
  - line: 215
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: 7a180d5c9969bc54da8a06efe8f6aa59, type: 3}
    pauseAfter: 0.22000001
    readSeconds: 2.7925925
    segments:
    - text: Not quite.
      weight: 1
      cues: []
    - text: That word belongs somewhere else.
      weight: 1.54
      cues: []
  - line: 216
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: ae4449f28085858468d492d8fd1e92b8, type: 3}
    pauseAfter: 0.66
    readSeconds: 5.014815
    segments:
    - text: 'That''s what the machine learned:'
      weight: 1.51
      cues: []
    - text: words that mean similar things live close together.
      weight: 2.85
      cues: []
  - line: 217
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: bc8bb77f38118ff4aa14fe7c501dc696, type: 3}
    pauseAfter: 1.1
    readSeconds: 6.9962964
    segments:
    - text: Words get their meaning from the words around them.
      weight: 2.81
      cues:
      - sentence
    - text: A fluffy blue creature
      weight: 1.49
      cues: []
    - text: isn't just any creature.
      weight: 1.39
      cues: []
  - line: 218
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: b299a83c7ddcbe141a0e1c0100446a1b, type: 3}
    pauseAfter: 1.1
    readSeconds: 12.411111
    segments:
    - text: 'So each word asks a question:'
      weight: 2.01
      cues:
      - look
    - text: which words before me help explain me?
      weight: 2.33
      cues: []
    - text: Creature looks back at every word before it.
      weight: 2.69
      cues: []
    - text: 'It can''t look ahead:'
      weight: 1.24
      cues: []
    - text: those words aren't written yet.
      weight: 1.55
      cues: []
  - line: 219
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: 5f2009e2cbd8ee846a713d5fc7655ec4, type: 3}
    pauseAfter: 1.1
    readSeconds: 12.681481
    segments:
    - text: It splits its attention between them,
      weight: 2.03
      cues:
      - shares
    - text: like slicing a pie.
      weight: 1.64
      cues: []
    - text: The slices always add up to one hundred percent.
      weight: 3.01
      cues: []
    - text: Fluffy and blue get the big slices,
      weight: 2.22
      cues: []
    - text: because they describe the creature.
      weight: 1.69
      cues: []
  - line: 244
    speaker: 0
    tag: GUIDE
    clip: {fileID: 8300000, guid: 3617c05516374164b896cc57f965eac4, type: 3}
    pauseAfter: 1.1
    readSeconds: 11.099999
    segments:
    - text: Then creature mixes in meaning from each word,
      weight: 2.86
      cues:
      - blend
    - text: by the size of its slice.
      weight: 1.85
      cues: []
    - text: Now it doesn't mean just any creature.
      weight: 2.27
      cues: []
    - text: It means a fluffy,
      weight: 1.15
      cues: []
    - text: blue creature.
      weight: 0.9
      cues: []
  - line: 220
    speaker: 0
    tag: GUIDE
