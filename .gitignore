# Unity .gitignore Template
# Source: https://github.com/github/gitignore/blob/main/Unity.gitignore

.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Blender auto-backups
*.blend1
*.blend1.meta

# MemoryCaptures / Recordings
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE / Editor cache & generated files
.vs/
.vsconfig
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
mono_crash.*

# Builds & Packages
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# TestRunner generated files
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Auto-generated cache in Assets folder
/[Aa]ssets/[Ss]ceneDependencyCache*

# Local scratch and nested project directories
/My project/
/My project (1)/
/My project (2)/
/Neural Game/
